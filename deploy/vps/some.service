# The prod app. Installed as /etc/systemd/system/some.service.
# It listens on 127.0.0.1 only; nginx is the one door in from the internet.
# One process on purpose: the 'use cache' entries and their updateTag invalidation live in this
# process's memory, so a second instance would serve stale pages (docs: self-hosting, shared cache).
[Unit]
Description=SoMe app (Next.js)
After=network-online.target
Wants=network-online.target
# Before the first release there is nothing to run; don't start (and restart-loop) until there is.
ConditionPathExists=/srv/some/current/.next/BUILD_ID

[Service]
Type=simple
User=deploy
Group=deploy
# A symlink to the live release; a restart follows it to the new one.
WorkingDirectory=/srv/some/current
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3
LimitNOFILE=65535

# Hardening: the app can write only under /srv/some and can't gain privileges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/some
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
