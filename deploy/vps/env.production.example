# Copy to /srv/some/shared/.env.production on the VPS (owner deploy, chmod 600) and fill in the
# prod values. Never commit the real file. NEXT_PUBLIC_ values are baked in at build time, so after
# changing one, deploy again; the others take effect on `sudo systemctl restart some.service`.
# No quotes, no spaces around "=".

# Supabase some-prod -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<prod-project-id>.supabase.co
# "Publishable key", starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret keys" -> create one named "vps", starts with sb_secret_. Server only: never in a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Brevo (client's account) -> SMTP & API -> API keys. Without these two the app sends no approval emails.
BREVO_API_KEY=
# A sender address verified in Brevo, e.g. no-reply@theirl.net
EMAIL_FROM=

# Optional: leave these commented out until they have a value. An empty DEFAULT_COMMUNITY= is not
# "unset": the app would take the empty name and redirect "/" to itself.
# Slug of the community shown at the platform's "/" (it must exist in the prod database)
#DEFAULT_COMMUNITY=
# Communities on their own domain: "host=slug,host=slug" (src/lib/domains.ts)
#COMMUNITY_DOMAINS=
